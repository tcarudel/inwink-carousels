{
  "id": "0b6b8a24-9fd3-4c79-8739-9e94620d73f1",
  "type": "itemslist",
  "customCSS": "/* Gabarit CRSL – rendu en liste classique tant qu'aucune classe crsl- n'est appliquée au bloc.\n   Contrat pour les carrousels : .crsl-f-picture, .crsl-f-title, .crsl-content (obligatoires), .crsl-f-color (facultatif). */\n##contentid .crsl-f-color { display: none; }\n##contentid .image-light .picture-wrapper:before { background-color: rgba(255, 255, 255, 0.3); }\n##contentid .image-dark .picture-wrapper:before { background-color: rgba(0, 0, 0, 0.3); }\n##contentid :is(.image-dark, .image-light) .picture-wrapper:before { content: ''; position: absolute; inset: 0; z-index: 1; }\n##contentid .text-center :is(.header-container, .description) { text-align: center; }\n##contentid .text-center a[role=button] { margin-left: auto; margin-right: auto; }\n##contentid .text-right :is(.header-container, .description) { text-align: right; }\n##contentid .text-right a[role=button] { margin-left: auto; }\n##contentid .itemcontent { display: flex; flex-flow: column nowrap; gap: 20px; height: 100%; padding: 0; cursor: initial; user-select: initial; }\n##contentid .picture-wrapper { display: flex; position: relative; }\n##contentid .picture-wrapper .picture { width: 100%; height: max(28vh, 10rem); max-height: 220px; object-fit: cover; }\n##contentid .image-cutout .picture-wrapper .picture { object-fit: contain; }\n##contentid .itemcontent .content-wrapper { display: flex; flex-flow: column nowrap; align-items: flex-start; flex: 1; gap: 1rem; width: 100%; }\n##contentid .itemcontent .content-wrapper .header-container { width: 100%; }\n##contentid .itemcontent .content-wrapper :is(h3, h4, .description) { margin: 0; width: 100%; }\n##contentid .card .content-wrapper { padding: 0 20px 20px 20px; }\n##contentid .card :first-child.content-wrapper { padding: 20px; }\n##contentid .card .content-wrapper * + a[role=button] { margin-top: auto; }\n##contentid .inwink-item { container-type: inline-size; }",
  "properties": {
    "template": {
      "type": "article",
      "doNotApplyLink": true,
      "conditionalClasses": {
        "text-left": [
          {
            "name": "text-position",
            "op": "eq",
            "val": "left"
          }
        ],
        "text-center": [
          {
            "name": "text-position",
            "op": "eq",
            "val": "center"
          }
        ],
        "text-right": [
          {
            "name": "text-position",
            "op": "eq",
            "val": "right"
          }
        ],
        "image-dark": [
          {
            "name": "image-opacity",
            "op": "eq",
            "val": "dark"
          }
        ],
        "image-light": [
          {
            "name": "image-opacity",
            "op": "eq",
            "val": "light"
          }
        ],
        "image-cutout": [
          {
            "name": "picture-cutout",
            "op": "eq",
            "val": true
          }
        ],
        "card": [
          {
            "name": "card-display",
            "op": "eq",
            "val": true
          }
        ]
      },
      "blocs": [
        {
          "type": "div",
          "className": "picture-wrapper crsl-f-picture",
          "showIf": [
            {
              "not": {
                "or": [
                  {
                    "name": "picture",
                    "op": "isempty"
                  },
                  {
                    "name": "picture",
                    "op": "eq",
                    "val": ""
                  },
                  {
                    "name": "picture",
                    "op": "eq",
                    "val": null
                  }
                ]
              }
            }
          ],
          "blocs": [
            {
              "type": "inwinkimage",
              "className": "picture",
              "properties": {
                "lazy": true,
                "target": "picture",
                "alt": [
                  "title"
                ],
                "sizes": "min(100cqw, 1280px)",
                "availableSizes": [
                  600,
                  1000,
                  1600
                ],
                "defaultSize": 1000
              }
            }
          ]
        },
        {
          "type": "div",
          "className": "content-wrapper crsl-content",
          "blocs": [
            {
              "type": "header",
              "className": "header-container",
              "blocs": [
                {
                  "type": "h4",
                  "className": "bloc-accent",
                  "showIf": [
                    {
                      "not": {
                        "or": [
                          {
                            "name": "pretitle",
                            "op": "isempty"
                          },
                          {
                            "name": "pretitle",
                            "op": "eq",
                            "val": ""
                          },
                          {
                            "name": "pretitle",
                            "op": "eq",
                            "val": null
                          }
                        ]
                      }
                    }
                  ],
                  "fields": [
                    {
                      "name": "pretitle"
                    }
                  ]
                },
                {
                  "type": "h3",
                  "className": "title crsl-f-title",
                  "showIf": [
                    {
                      "not": {
                        "or": [
                          {
                            "name": "title",
                            "op": "isempty"
                          },
                          {
                            "name": "title",
                            "op": "eq",
                            "val": ""
                          },
                          {
                            "name": "title",
                            "op": "eq",
                            "val": null
                          }
                        ]
                      }
                    }
                  ],
                  "fields": [
                    {
                      "name": "title"
                    }
                  ]
                }
              ]
            },
            {
              "type": "div",
              "className": "description",
              "showIf": [
                {
                  "not": {
                    "or": [
                      {
                        "name": "description",
                        "op": "isempty"
                      },
                      {
                        "name": "description",
                        "op": "eq",
                        "val": ""
                      },
                      {
                        "name": "description",
                        "op": "eq",
                        "val": null
                      }
                    ]
                  }
                }
              ],
              "fields": [
                {
                  "name": "description"
                }
              ]
            },
            {
              "type": "div",
              "className": "crsl-f-color",
              "showIf": [
                {
                  "not": {
                    "or": [
                      {
                        "name": "color",
                        "op": "isempty"
                      },
                      {
                        "name": "color",
                        "op": "eq",
                        "val": ""
                      },
                      {
                        "name": "color",
                        "op": "eq",
                        "val": null
                      }
                    ]
                  }
                }
              ],
              "fields": [
                {
                  "name": "color"
                }
              ]
            },
            {
              "type": "a",
              "role": "button",
              "className": "buttontitle",
              "showIf": [
                {
                  "not": {
                    "or": [
                      {
                        "name": "$link",
                        "op": "isempty"
                      },
                      {
                        "name": "$link",
                        "op": "eq",
                        "val": ""
                      },
                      {
                        "name": "$link",
                        "op": "eq",
                        "val": null
                      }
                    ]
                  }
                },
                {
                  "not": {
                    "or": [
                      {
                        "name": "buttontitle",
                        "op": "isempty"
                      },
                      {
                        "name": "buttontitle",
                        "op": "eq",
                        "val": ""
                      },
                      {
                        "name": "buttontitle",
                        "op": "eq",
                        "val": null
                      }
                    ]
                  }
                }
              ],
              "fields": [
                {
                  "name": "buttontitle"
                }
              ],
              "useItemLink": true
            }
          ]
        }
      ]
    },
